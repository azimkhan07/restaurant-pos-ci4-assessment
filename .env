CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

database.default.database = database/restaurant_pos.sqlite
database.default.DBDriver = SQLite3
database.default.foreignKeys = true
database.default.busyTimeout = 5000
database.default.synchronous = NORMAL

# Optional: when set, API requests must send X-API-Key with this value.
# api.key = local-demo-key

logger.threshold = 4
